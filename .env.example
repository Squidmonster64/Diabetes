# Frontend (apps/web) - Vite exposes only VITE_ prefixed vars to the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
# Local Vite-dev only. Never set this in a production build. When set, the
# PWA sends X-Dev-Patient-Id so the in-memory API can be exercised without
# Supabase. Production always requires a verified Supabase session.
VITE_DEV_PATIENT_ID=

# Backend (apps/api)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Service-role key: server-side only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_PATH=./data/australian_foods.sqlite
PORT=8080
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional. Server-side language interpretation and Fragments-compatible
# transcription. Never expose these values in the browser, a PWA, or source.
# Language interpretation never calculates insulin doses or nutrient totals.
OPENAI_API_KEY=
# Chat Completions model for structured JSON (Diabetes event + Nutrition meal).
# Fragments' audio model gpt-4o-transcribe cannot emit JSON schemas.
# Default: gpt-4o-mini. Keep this unless the Diabetes regression suite fails.
OPENAI_INTERPRETATION_MODEL=gpt-4o-mini
# Fragments transcription defaults. Used if server-side audio transcription is enabled.
TRANSCRIPTION_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional: absolute path to the built web app (apps/web/dist) to serve it
# from this same service. Auto-detected in the monorepo; set explicitly in
# a packaged/Railway deployment if auto-detection does not apply.
STATIC_WEB_DIR=
