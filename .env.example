# Frontend (apps/web) - Vite exposes only VITE_ prefixed vars to the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
# Local Vite-dev only. Never set this in a production build. When set, the
# PWA sends X-Dev-Patient-Id so the in-memory API can be exercised without
# Supabase. Production always requires a verified Supabase session.
VITE_DEV_PATIENT_ID=

# Backend (apps/api)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Service-role key: server-side only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_PATH=./data/australian_foods.sqlite
PORT=8080
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional. Used only to convert meal language into a structured food list.
# Never used for nutrition values or insulin doses. Deterministic parsing is
# the CI path and the fallback when this is unset.
OPENAI_API_KEY=
# Optional: absolute path to the built web app (apps/web/dist) to serve it
# from this same service. Auto-detected in the monorepo; set explicitly in
# a packaged/Railway deployment if auto-detection does not apply.
STATIC_WEB_DIR=
